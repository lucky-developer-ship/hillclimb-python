{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,__pycache__/**,**/*.pyc,sprites.py,assets.py,particle_system.py,sound_manager.py,background.py,build.py,ghost.py,save_data.py,test_drive.py,**/__pycache__/**,**/pycache/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
